# ---- Database (required) ----
# Postgres only. Start one with: docker compose up -d
DATABASE_URL="postgresql+psycopg://smartsme:smartsme@localhost:5432/smartsme"

# ---- Auth ----
# Any long random string, 32+ characters. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET="change-me-to-a-long-random-string-32-chars-min"
# Set these when the API and SPA are served from different sites over HTTPS.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ---- Frontend ----
# Browser origins allowed to call the API with credentials.
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# ---- Sign-in throttling ----
# Failures before an account is locked. Employees are exempt from this lock;
# the per-IP limit below still applies to them.
LOGIN_MAX_ATTEMPTS=5
# Minutes the first lock lasts; each further block of failures doubles it.
LOGIN_LOCK_MINUTES=15
# Sliding window for the per-IP limit.
LOGIN_WINDOW_MINUTES=15
# Failed attempts one IP may make across all accounts in that window.
LOGIN_MAX_IP_ATTEMPTS=20

# ---- Behaviour ----
SEED_DEMO_DATA=true
DISABLE_WORKER=false
WORKER_POLL_SECONDS=1.0

# ---- AI provider (optional; enables smarter NLP and all OCR) ----
# Set ONE key. If several are set the first below wins, unless AI_PROVIDER
# forces a choice (anthropic | openai | groq | google).
AI_PROVIDER=""

# -- Anthropic (Claude): one key covers both NLP and OCR --
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# -- OpenAI, or ANY OpenAI-compatible endpoint (OpenRouter, Together, Ollama) --
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# -- Groq: OCR needs a vision model, the text-only default cannot read images --
GROQ_API_KEY=""
GROQ_MODEL="meta-llama/llama-4-scout-17b-16e-instruct"

# -- Google Gemini --
GOOGLE_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"
