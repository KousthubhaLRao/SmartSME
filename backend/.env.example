# ---- Database (required) ----
# Postgres only. Start one with: docker compose up -d
DATABASE_URL="postgresql+psycopg://smartsme:smartsme@localhost:5432/smartsme"

# ---- Auth ----
# Any long random string, 32+ characters. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET="change-me-to-a-long-random-string-32-chars-min"
# Set these when the API and SPA are served from different sites over HTTPS.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ---- Frontend ----
# Browser origins allowed to call the API with credentials.
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# ---- Sign-in throttling ----
# Failures before an account is locked. Employees are exempt from this lock;
# the per-IP limit below still applies to them.
LOGIN_MAX_ATTEMPTS=5
# Minutes the first lock lasts; each further block of failures doubles it.
LOGIN_LOCK_MINUTES=15
# Sliding window for the per-IP limit.
LOGIN_WINDOW_MINUTES=15
# Failed attempts one IP may make across all accounts in that window.
LOGIN_MAX_IP_ATTEMPTS=20

# ---- Reading an order from a photo ----
# Two paths, and they are a genuine trade-off:
#
#   OCR.space   free (25,000 pages/month, no card), but a PRINTED-text engine.
#               Good on typed invoices and screenshots; its own docs say it
#               does not do handwriting.
#   Vision LLM  any of the AI keys further down that supports images. Reads
#               handwriting, and can be told to ignore a crossed-out line -
#               but it is paid.
#
# With both configured the vision model is used and this is the fallback.
OCR_SPACE_API_KEY=""
OCR_SPACE_ENGINE=2

# ---- Inbound orders ----
# The domain shown on the Inbox page as orders+<token>@here. Display only -
# mail is routed by the token - so this matters when you point at a real
# mailbox and want the address people are given to be the right one.
INBOX_DOMAIN=smartsme.local

# Collect orders arriving by email. Off by default so an unconfigured mailbox
# is not polled. The defaults below point at Mailpit, which docker compose runs.
# `.
un-dev.ps1 -WithEmail` turns this on for one run without editing anything.
EMAIL_INGEST_ENABLED=false
EMAIL_PROTOCOL=pop3          # pop3 for Mailpit; imap for a real mailbox
EMAIL_HOST=localhost
EMAIL_PORT=1110
EMAIL_USER=smartsme
EMAIL_PASSWORD=smartsme
EMAIL_SSL=false
EMAIL_FOLDER=INBOX
EMAIL_BATCH=25

# A bot token from Telegram's @BotFather. Free, instant, no card.
TELEGRAM_BOT_TOKEN=""

# Seconds between inbound sweeps.
INBOUND_POLL_SECONDS=30

# ---- Connection pool ----
# (pool size + overflow) x uvicorn workers must stay under Postgres
# max_connections, which defaults to 100.
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=1800
SERVER_THREADS=60

# ---- Event dispatch ----
# inline  : events are applied inside the request, so a sale's stock movement
#           has landed by the time the write returns. The default, and what the
#           SPA expects.
# celery  : events are handed to Redis and applied by a Celery worker. Much
#           higher write throughput; the write returns before effects apply, so
#           the UI is briefly behind. Needs `docker compose up -d` for Redis,
#           plus a worker and a beat process (see run-dev.ps1 -Celery).
EVENT_DISPATCH=inline
REDIS_URL="redis://localhost:6379/0"
# How often the outbox is swept for events the broker never received.
CELERY_SWEEP_SECONDS=5
# A pending event older than this is considered stranded and re-enqueued.
CELERY_STRANDED_SECONDS=30

# ---- Behaviour ----
SEED_DEMO_DATA=true
DISABLE_WORKER=false
WORKER_POLL_SECONDS=1.0

# ---- AI provider (optional; enables smarter NLP and all OCR) ----
# Set ONE key. If several are set the first below wins, unless AI_PROVIDER
AI_PROVIDER=""

# -- Anthropic (Claude): one key covers both NLP and OCR --
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# -- OpenAI, or ANY OpenAI-compatible endpoint (OpenRouter, Together, Ollama) --
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"


# -- Google Gemini --
GOOGLE_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"
